# Server
PORT=5001
NODE_ENV=development

# MySQL (same credentials / schema as the existing app.py / 02_init.sql)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DATABASE=food_supply
MYSQL_PORT=3306

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Allow self-registration of new users (true/false)
ALLOW_REGISTRATION=true
